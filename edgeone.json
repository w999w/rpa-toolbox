{
  "outputDirectory": "dist",
  "installCommand": "echo Static site - no install required",
  "buildCommand": "echo Static site - dist is ready",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/*.mjs",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
